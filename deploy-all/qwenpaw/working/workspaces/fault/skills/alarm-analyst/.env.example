# 指标 API 基础地址
INOE_API_BASE_URL=

# 指标 API Token（JWT）
# INOE_API_TOKEN=your_metric_api_token_here
INOE_API_TOKEN=your_metric_api_token_here

ALARM_ANALYST_METRIC_TIMEOUT_SECONDS=120
ALARM_ANALYST_METRIC_PAGE_SIZE=20
# 知识库只读检索：可选，未设置时读取应用 last_api；包含 /api/portal
# 通过进程环境导出，脚本不自动加载本文件或技能目录的 .env
# ALARM_ANALYST_KNOWLEDGE_API_BASE_URL=http://127.0.0.1:8088/api/portal
ALARM_ANALYST_KNOWLEDGE_TIMEOUT_SECONDS=60
# 应用开启认证时提供已授权的 Bearer 令牌；不要使用 INOE_API_TOKEN
# ALARM_ANALYST_KNOWLEDGE_API_TOKEN=
ORDER_CREATE_NOTIFY_PUSH_URL=
ORDER_CREATE_NOTIFY_DINGTALK_WEBHOOK_URL=
ORDER_CREATE_NOTIFY_DINGTALK_SECRET=
ORDER_CREATE_NOTIFY_DINGTALK_KEYWORD=
ORDER_CREATE_NOTIFY_FEISHU_WEBHOOK_URL=
ORDER_CREATE_NOTIFY_FEISHU_SECRET=
ORDER_CREATE_NOTIFY_TIMEOUT_SECONDS=8
ORDER_CREATE_NOTIFY_MENTION_ALL=true
